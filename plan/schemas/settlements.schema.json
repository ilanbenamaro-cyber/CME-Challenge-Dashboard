{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settlements.schema.json",
  "title": "settlements envelope (D7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset",
    "generated_at",
    "data_as_of",
    "source",
    "status",
    "errors",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset": {
      "const": "settlements"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "root",
                  "contract_code",
                  "settle",
                  "trade_date"
                ],
                "properties": {
                  "root": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{1,4}$"
                  },
                  "contract_code": {
                    "type": "string"
                  },
                  "settle": {
                    "type": "number"
                  },
                  "trade_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}